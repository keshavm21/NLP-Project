# VulnTriage — Environment Variables
# Copy this file to .env and fill in your values.
# See docs/DATA.md for how to obtain each key.

# NVD API key (free, from https://nvd.nist.gov/developers/request-an-api-key)
# Required for reasonable download speeds; without it NVD rate-limits to ~10 req/min.
NVD_API_KEY=

# (Optional) GitHub Personal Access Token for higher GHSA API rate limits.
# Not strictly required — the advisory-database is cloned via git.
# GITHUB_TOKEN=
